<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:le="clr-namespace:H.Controls.Diagram.Presenter.Expressions">
    <DataTemplate DataType="{x:Type le:VarExpressionsPresenter}">
        <Border MinWidth="400">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top"
                           LastChildFill="False">
                    <Button Command="{Binding AddCommand}"
                            Content="添加变量" />
                    <Button Command="{ShowNotImplementedCommand}"
                            Content="导入" Margin="5"/>
                    <Button Command="{ShowNotImplementedCommand}"
                            Content="导出" />
                    <TextBox Width="200"
                             Margin="10,0,0,0"
                             Cattach.Watermark="请输入变量名称"
                             Style="{DynamicResource {x:Static TextBoxKeys.Delete}}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <DataGrid AutoGenerateColumns="False"
                          ItemsSource="{Binding SearchedVarExpressions}"
                          RowHeaderWidth="0"
                          SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="50"
                                                Header="序号">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center">
                                        <b:Interaction.Behaviors>
                                            <TextBlockIndexOfBebavior Format="{}{0}"
                                                                      Item="{Binding}"
                                                                      Source="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header, Mode=OneWay}" />
                                        </b:Interaction.Behaviors>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding Name}"
                                            Header="名称"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding GroupName}"
                                            Header="分组"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding Description}"
                                            Header="注释"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding DataType}"
                                            Header="类型"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding CurrentValue}"
                                            Header="当前值"
                                            IsReadOnly="True" />
                        <DataGridTemplateColumn Width="100"
                                                Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <UniformGrid Rows="1">
                                        <FontIconButton Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{x:Static FontIcons.Edit}"
                                                        ToolTip="编辑" />
                                        <FontIconButton Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{x:Static FontIcons.Delete}"
                                                        ToolTip="删除" />
                                    </UniformGrid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>