<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:h="https://github.com/HeBianGu"
                    xmlns:ld="clr-namespace:H.Controls.Diagram.Presenter.DiagramDatas"
                    xmlns:ldb="clr-namespace:H.Controls.Diagram.Presenter.DiagramDatas.Base"
                    xmlns:local="clr-namespace:H.Controls.Diagram.Presenter"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <DataTemplate DataType="{x:Type ldb:DiagramDataBase}">
        <Diagram x:Name="diagram"
                 Width="{Binding Width}"
                 Height="{Binding Height}"
                 Padding="0"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 HorizontalContentAlignment="Stretch"
                 VerticalContentAlignment="Stretch"
                 AllowDrop="True"
                 BorderBrush="{DynamicResource {x:Static h:BrushKeys.ForegroundAssist}}"
                 BorderThickness="2"
                 DataSource="{Binding DataSource}"
                 Layout="{Binding Layout}"
                 LinkDrawer="{Binding LinkDrawer}"
                 Message="{Binding Message, Mode=OneWayToSource}"
                 UseAnimation="False">
            <Control.Resources>
                <BindingProxy x:Key="Proxy"
                              Data="{Binding ElementName=diagram}" />
            </Control.Resources>
            <Diagram.ContextMenu>
                <ContextMenu>
                    <ContextMenu.Resources>
                        <Style BasedOn="{StaticResource {x:Static MenuItemKeys.BindCommand}}"
                               TargetType="MenuItem">
                            <Setter Property="CommandParameter" Value="{Binding Source={StaticResource Proxy}, Path=Data}" />
                        </Style>
                    </ContextMenu.Resources>
                    <ContextMenu.ItemsSource>
                        <CompositeCollection>
                            <MenuItem Cattach.Icon="{x:Static FontIcons.Flow}" Header="{x:Static ldb:DiagramDataCommandGroupNames.FlowControl}"
                                      ItemsSource="{Binding Source={StaticResource Proxy}, Path=Data.DataContext.Commands, Converter={GetGroupCommandsValueConverter GroupName={x:Static ldb:DiagramDataCommandGroupNames.FlowControl}}}" />
                            <MenuItem Cattach.Icon="{x:Static FontIcons.View}"  Header="{x:Static ldb:DiagramDataCommandGroupNames.ViewControl}"
                                      ItemsSource="{Binding Source={StaticResource Proxy}, Path=Data.DataContext.Commands, Converter={GetGroupCommandsValueConverter GroupName={x:Static ldb:DiagramDataCommandGroupNames.ViewControl}}}" />
                            <MenuItem Cattach.Icon="{x:Static FontIcons.Setting}"  Header="{x:Static ldb:DiagramDataCommandGroupNames.DataConfiguration}"
                                      ItemsSource="{Binding Source={StaticResource Proxy}, Path=Data.DataContext.Commands, Converter={GetGroupCommandsValueConverter GroupName={x:Static ldb:DiagramDataCommandGroupNames.DataConfiguration}}}" />
                            <MenuItem Cattach.Icon="{x:Static FontIcons.SelectAll}"  Header="流程操作"
                                      ItemsSource="{Binding Source={StaticResource Proxy}, Path=Data.CommandBindings}">
                                <MenuItem.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Static MenuItemKeys.Default}}"
                                           TargetType="MenuItem">
                                        <Setter Property="Command" Value="{Binding}" />
                                        <Setter Property="CommandTarget" Value="{Binding Source={StaticResource Proxy}, Path=Data}" />
                                        <Setter Property="Header" Value="{Binding Command.Text}" />
                                        <Setter Property="Cattach.Icon" Value="{Binding Command.Icon}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>

                            <Separator Style="{DynamicResource {x:Static SeparatorKeys.Default}}" />
                            <MenuItem Cattach.Icon="{x:Static FontIcons.More}" Header="更多&gt;&gt;">
                                <MenuItem.ItemsSource>
                                    <CompositeCollection>
                                        <CollectionContainer Collection="{Binding Source={StaticResource Proxy}, Path=Data.DataContext.Commands}" />
                                    </CompositeCollection>
                                </MenuItem.ItemsSource>
                            </MenuItem>
                        </CompositeCollection>
                    </ContextMenu.ItemsSource>
                </ContextMenu>
            </Diagram.ContextMenu>
            <Diagram.Background>
                <SolidColorBrush Opacity="0.02"
                                 Color="Gray" />
            </Diagram.Background>
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="ItemsChanged">
                    <b:InvokeCommandAction Command="{Binding ItemsChangedCommand}"
                                           PassEventArgsToCommand="True" />
                </b:EventTrigger>
                <b:EventTrigger EventName="AddNoded">
                    <b:InvokeCommandAction Command="{Binding AddNodedCommand}"
                                           PassEventArgsToCommand="True" />
                </b:EventTrigger>
                <b:EventTrigger EventName="SelectedPartChanged">
                    <b:InvokeCommandAction Command="{Binding SelectedPartChangedCommand}"
                                           PassEventArgsToCommand="True" />
                </b:EventTrigger>
                <b:EventTrigger EventName="MouseDoubleClick">
                    <b:InvokeCommandAction Command="{Binding MouseDoubleClickCommand}"
                                           PassEventArgsToCommand="True" />
                </b:EventTrigger>
                <b:EventTrigger EventName="Loaded">
                    <b:InvokeCommandAction Command="{Binding LoadedCommand}"
                                           PassEventArgsToCommand="True" />
                </b:EventTrigger>
            </b:Interaction.Triggers>
            <b:Interaction.Behaviors>
                <DiagramDropTypeNodeDataBehavior NodeType="{Binding NodeType}"
                                                 UseAutoAddLinkOnEnd="True" />
            </b:Interaction.Behaviors>
        </Diagram>
    </DataTemplate>
</ResourceDictionary>