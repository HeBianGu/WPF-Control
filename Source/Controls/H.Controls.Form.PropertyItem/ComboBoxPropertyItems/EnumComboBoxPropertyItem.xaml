<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:H.Controls.Form.PropertyItem.ComboBoxPropertyItems">
    <DataTemplate DataType="{x:Type local:EnumComboBoxPropertyItem}">
        <ComboBox Cattach.UseGuide="False"
                  IsHitTestVisible="{Binding IsHitTestVisible}"
                  ItemsSource="{Binding Collection}"
                  SelectedItem="{Binding Value}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:RadioButtonEnumPropertyItem}">
        <ListBox Cattach.UseGuide="False"
                 IsHitTestVisible="{Binding IsHitTestVisible}"
                 SelectedItem="{Binding Value}"
                 ItemsSource="{Binding Collection}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <RadioButton Content="{Binding}" Margin="0 0 10 0"
                                 IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.Template>
                <ControlTemplate>
                    <ItemsPresenter />
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </DataTemplate>
</ResourceDictionary>