<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:H.Extensions.Computer.ComputerManagementObjects">
    <DataTemplate DataType="{x:Type local:ManagementObjectPresenterBase}">
        <ListBox ItemsSource="{Binding ComputerProcessInfos}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Id}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding MemoryUsage}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding CpuUsage}" Margin="0,0,10,0" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <!--<ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="0,5,0,0" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Margin" Value="0,0,0,10" />
                        </Style>
                    </GroupStyle.ContainerStyle>
            </ListBox.GroupStyle>-->
        </ListBox>
    </DataTemplate>
</ResourceDictionary>