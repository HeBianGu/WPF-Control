<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:h="https://github.com/HeBianGu"
                    xmlns:lb="clr-namespace:H.Components.VisionDiagram.Base">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/H.Components.VisionDiagram;component/Presenters/VisionPropertyConditionsPrensenter.xaml" />
        <ResourceDictionary Source="pack://application:,,,/H.Components.VisionDiagram;component/Presenters/VisionResultImage.xaml" />
        <ResourceDictionary Source="pack://application:,,,/H.Components.VisionDiagram;component/Presenters/HelpPresenter.xaml" />
        <ResourceDictionary Source="pack://application:,,,/H.Components.VisionDiagram;component/Presenters/CropImageTextPropertyItem.xaml" />
        <ResourceDictionary Source="pack://application:,,,/H.Components.VisionDiagram;component/Presenters/StyleNodeData.xaml" />
        <ResourceDictionary Source="pack://application:,,,/H.Components.VisionDiagram;component/Presenters/ShapeViewPropertyItem.xaml" />
        <ResourceDictionary Source="pack://application:,,,/H.Components.VisionDiagram;component/ResultPresenters/ValueResultPresenter.xaml" />
        <ResourceDictionary Source="pack://application:,,,/H.Components.VisionDiagram;component/ResultPresenters/DataGridResultPresenter.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <DataTemplate DataType="{x:Type lb:SrcFileLoopMode}">
        <TextBlock>
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}"
                                     Value="All">
                            <Setter Property="Text" Value="运行全部" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}"
                                     Value="Selected">
                            <Setter Property="Text" Value="运行选中" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>
</ResourceDictionary>
