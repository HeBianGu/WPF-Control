<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="https://github.com/HeBianGu"
                    xmlns:local="clr-namespace:H.Presenters.Common.Presenters">
    <DataTemplate DataType="{x:Type local:ItemsControlPresenter}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <CollectionViewSource x:Key="GroupedNodeDatas"
                                      Source="{Binding ItemsSource}">
                    <CollectionViewSource.GroupDescriptions>
                        <PropertyGroupDescription PropertyName="GroupName" />
                    </CollectionViewSource.GroupDescriptions>
                </CollectionViewSource>
            </ScrollViewer.Resources>
            <ItemsControl x:Name="lb"
                          HorizontalAlignment="Stretch"
                          ItemTemplate="{Binding ItemContentTemplate}"
                          ItemsSource="{Binding ItemsSource}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <GroupBox Margin="0,0,0,2"
                                                      Header="{Binding Path=Name}">
                                                <ItemsPresenter Margin="2,0" />
                                            </GroupBox>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
            </ItemsControl>
        </ScrollViewer>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding UseGroupName}"
                         Value="False">
                <Setter TargetName="lb" Property="ItemsSource" Value="{Binding ItemsSource}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>