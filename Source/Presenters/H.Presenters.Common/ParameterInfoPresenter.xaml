<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:local="clr-namespace:H.Presenters.Common">
    <DataTemplate DataType="{x:Type local:ParameterInfosPresenter}">
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.Resources>
                <CollectionViewSource x:Key="GroupedParameterInfoPresenters"
                                      Source="{Binding ParameterInfoPresenters}">
                    <CollectionViewSource.GroupDescriptions>
                        <PropertyGroupDescription PropertyName="GroupName" />
                    </CollectionViewSource.GroupDescriptions>
                </CollectionViewSource>
            </Grid.Resources>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedParameterInfoPresenters}}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander Margin="0,1"
                                                          Header="{Binding Name}"
                                                          Style="{DynamicResource {x:Static ExpanderKeys.ToggleRight}}">
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:ParameterInfoPresenter}">
        <Grid Margin="0,1"
              Background="Transparent"
              ToolTip="{Binding ParameterInfo.DisplayName}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="ParameterInfo" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="2,0"
                       VerticalAlignment="Center"
                       Text="{Binding ParameterInfo.DisplayName}">
                <TextBlock.ToolTip>
                    <PriorityBinding>
                        <Binding Path="ParameterInfo.Name" />
                        <Binding Path="ParameterInfo.Description" />
                        <Binding Path="ParameterInfo.DisplayName" />
                    </PriorityBinding>
                </TextBlock.ToolTip>
            </TextBlock>
            <Button x:Name="btn_default"
                    Grid.Column="1"
                    Height="Auto"
                    Margin="2"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Command="{Binding SetDefaultCommand}"
                    ToolTip="恢复默认值"
                    Visibility="{Binding UseSetDefault, Converter={x:Static Converter.GetTrueToVisible}}">
                <Border Width="8"
                        Height="8"
                        Margin="2"
                        Background="{DynamicResource {x:Static BrushKeys.BorderBrush}}"
                        BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Opacity="0.8" />
            </Button>
            <ContentPresenter Grid.Column="2"
                              Content="{Binding}">
                <ContentPresenter.ContentTemplateSelector>
                    <local:ParameterInfoDataTemplateSelector>
                        <local:ParameterInfoDataTemplateSelector.TextDataTemplate>
                            <DataTemplate DataType="{x:Type local:ParameterInfoPresenter}">
                                <TextBox Width="Auto"
                                         HorizontalAlignment="Stretch"
                                         HorizontalContentAlignment="Stretch"
                                         IsReadOnly="{Binding IsReadOnly}"
                                         Text="{Binding CurrentValue}">
                                    <Cattach.Attach>
                                        <TextBlock Margin="1,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding ParameterInfo.Unit}" />
                                    </Cattach.Attach>
                                </TextBox>
                            </DataTemplate>
                        </local:ParameterInfoDataTemplateSelector.TextDataTemplate>
                        <local:ParameterInfoDataTemplateSelector.ComboBoxDataTemplate>
                            <DataTemplate DataType="{x:Type local:ParameterInfoPresenter}">
                                <ComboBox IsEnabled="{Binding IsReadOnly, Converter={GetTrueToFalseValueConverter}}"
                                          ItemsSource="{Binding ParameterInfo.Options}"
                                          SelectedItem="{Binding CurrentValue}" />
                            </DataTemplate>
                        </local:ParameterInfoDataTemplateSelector.ComboBoxDataTemplate>
                        <local:ParameterInfoDataTemplateSelector.CheckBoxDataTemplate>
                            <DataTemplate DataType="{x:Type local:ParameterInfoPresenter}">
                                <CheckBox IsChecked="{Binding CurrentValue}"
                                          IsEnabled="{Binding IsReadOnly, Converter={GetTrueToFalseValueConverter}}" />
                            </DataTemplate>
                        </local:ParameterInfoDataTemplateSelector.CheckBoxDataTemplate>
                        <local:ParameterInfoDataTemplateSelector.CommandDataTemplate>
                            <DataTemplate>
                                <Button Command="{Binding ExecuteCommandCommand}"
                                        Content="{Binding ParameterInfo.DisplayName}"
                                        IsEnabled="{Binding IsReadOnly, Converter={GetTrueToFalseValueConverter}}" />
                            </DataTemplate>
                        </local:ParameterInfoDataTemplateSelector.CommandDataTemplate>
                    </local:ParameterInfoDataTemplateSelector>
                </ContentPresenter.ContentTemplateSelector>
            </ContentPresenter>
        </Grid>
    </DataTemplate>
</ResourceDictionary>